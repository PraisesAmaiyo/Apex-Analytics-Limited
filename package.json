{
  "name": "apexanalyricltd",
  "version": "1.0.0",
  "description": "apexanalyricltd webpage",
  "main": "index.js",
  "scripts": {
    "watch:sass": "sass --quiet-deps sass/main.scss css/style.css --watch",
    "devserver": "live-server",
    "start": "npm-run-all --parallel devserver watch:sass",
    "compile:sass": "sass sass/main.scss css/style.comp.css",
    "prefix:css": "postcss css/style.comp.css --use autoprefixer -b 'last 10 versions' -o css/style.prefix.css",
    "compress:css": "sass css/style.prefix.css css/style.css --style=compressed",
    "update:browserslist": "npx update-browserslist-db@latest --quiet",
    "build:css": "npm-run-all update:browserslist compile:sass prefix:css compress:css",
    "sass:silent": "sass --quiet-deps sass/main.scss css/style.css"
  },
  "author": "Praises Amaiyo",
  "license": "ISC",
  "devDependencies": {
    "autoprefixer": "^10.4.14",
    "concat": "^1.0.3",
    "npm-run-all": "^4.1.5",
    "postcss-cli": "^10.1.0",
    "sass": "^1.92.1"
  },
  "dependencies": {
    "swiper": "^11.1.8"
  }
}
