         <input type="text" id="certNumber" placeholder="Enter Certificate Number" />

         <!-- <br /><br /> -->
         <button type="submit" id="verifyBtn" class="btn primary-btn">Verify</button>

         <div id="loader" style="display:none;" class="loader"></div>

         <div class="heading-minitext mt-2" id="result"></div>
      </div>
   </form>   <script src="https://code.iconify.design/iconify-icon/2.1.0/iconify-icon.min.js"></script>
</body>

</html>